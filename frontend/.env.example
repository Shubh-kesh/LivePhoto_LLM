# Frontend environment (safe defaults only).
# Never put AI keys, database passwords, bank secrets or service credentials in VITE_* vars —
# they are bundled into the browser and exposed to any user (M1 §39).
VITE_API_BASE_URL=http://localhost:8000

# VLM experiment UI visibility.
#   true  = diagnostic/manual experiment review flow on /capture (raw review + VLM test panel).
#   false = streamlined /capture flow: automatic backend liveness (VLM_PROVIDER) -> portrait review.
# Does NOT affect /xbiz/live_photo, and does NOT enable/disable backend liveness validation.
VITE_VLM_EXPERIMENT_UI_ENABLED=false

# Runtime (container) configuration — see docs/UAT_RUNTIME_CONFIGURATION.md. These LIVEPHOTO_*
# vars are read by the frontend container's entrypoint to generate runtime-config.js (no rebuild).
# They are NOT bundled into the browser via Vite.
#   LIVEPHOTO_APP_ENV=uat
#   LIVEPHOTO_API_BASE_URL=https://livephoto-api.example.internal
#   LIVEPHOTO_VLM_EXPERIMENT_UI_ENABLED=true