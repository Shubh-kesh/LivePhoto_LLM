{
  "$schema": "https://opencode.ai/config.json",
  // Conservative LivePhoto engineering permissions.
  // - git push / force-push can never run silently (deny).
  // - Normal local test/build/git commands are allowed; everything else asks.
  // - .env files are not readable; .env.example remains readable.
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "**/.env.local": "deny"
    },
    "edit": { "*": "allow" },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git checkout*": "allow",
      "git stash*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git push*": "deny",
      "git push": "deny",
      "npm ci": "allow",
      "npm install*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm exec*": "allow",
      "uv run *": "allow",
      "uv lock": "allow",
      "uv sync": "allow",
      "python3 *": "allow",
      "shasum*": "allow",
      "docker build*": "allow",
      "docker buildx*": "allow",
      "docker run*": "allow",
      "docker rm*": "allow",
      "docker image*": "allow",
      "ls*": "allow",
      "mkdir*": "allow",
      "rm *": "ask",
      "rm -rf*": "ask",
      "pkill*": "ask",
      "kill*": "ask",
      "curl*": "ask",
      "npx*": "ask"
    },
    "external_directory": { "*": "ask" }
  }
}