# ---------------------------------------------------------------------------
# LivePhoto .gitignore
# Protect secrets, credentials, biometric data and local build artifacts.
# ---------------------------------------------------------------------------

# ---- Environment & secrets -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
secrets/

# ---- Python / backend -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/

# ---- Node / frontend ---------------------------------------------------------
node_modules/
frontend/dist/
frontend/coverage/
npm-debug.log*
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/e2e/.fixtures/

# ---- ML / data (never commit biometric or customer data) ---------------------
ml/datasets/*
!ml/datasets/README.md
ml/experiments/data/
models/
*.onnx
*.pt
*.pth
*.h5
*.pb
*.tflite
*.joblib
*.pkl

# ---- Face model / MediaPipe assets (downloaded at dev setup; not committed) ----
frontend/model-assets/face_detector.task
frontend/public/mediapipe-wasm/

# ---- Portrait matting model (provisioned, pinned; not committed) ----
backend/model-assets/

# ---- M4 evaluation data / artifacts (never commit datasets or dumps) --------
local-data/
artifacts/
provider-response-dumps/

# ---- Biometric captures / local object storage --------------------------------
captures/
raw-captures/
local-object-storage/
objectstore-data/
minio-data/
uploads/
media/

# ---- Logs ---------------------------------------------------------------------
*.log
logs/

# ---- Certificates -------------------------------------------------------------
certs/

# ---- IDE / editor ---------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.orig

# ---- OS -------------------------------------------------------------------------
.DS_Store
Thumbs.db