# ---------------------------------------------------------------------------
# LivePhoto environment configuration (safe placeholders only).
# Copy to backend/.env for local development:  cp .env.example backend/.env
# Never commit real credentials, keys, bank URLs or customer identifiers.
# ---------------------------------------------------------------------------

# Application metadata
APP_NAME=LivePhoto
APP_ENV=local                 # local | test | development | uat | production
APP_VERSION=0.1.0

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console            # console (human) | json (production)

# CORS (JSON array of origins)
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false

# Persistence (MSSQL in production; optional locally)
# Leave empty to run the foundation without a database.
# Example SQL Server URL is intentionally left blank; do not commit real DSNs.
DATABASE_URL=

# OpenTelemetry (extension point; no collector configured in M1)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=livephoto-backend
OTEL_TRACES_EXPORTER=none     # none | console

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Security headers
HSTS_ENABLED=false            # enable only when serving over HTTPS in production

# VLM experiment (M4/M5.6) — DISABLED by default. See docs/UAT_RUNTIME_CONFIGURATION.md.
VLM_EXPERIMENT_ENABLED=false
# UAT: experiment available only when BOTH VLM_EXPERIMENT_ENABLED=true AND this is true.
VLM_UAT_LOCAL_EXPERIMENT_ENABLED=false
VLM_PROVIDER=                 # gemini | groq | openrouter | local | mock (empty = none)
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=1
VLM_MAX_FRAMES=3
VLM_MAX_SINGLE_IMAGE_BYTES=5242880
VLM_MAX_TOTAL_IMAGE_BYTES=15728640

# Structured VLM request/response/error diagnostics logging (M5.6 §27-36).
VLM_EXPERIMENT_LOGGING_ENABLED=false
# Optional raw LOCAL model response text (local provider only, non-production, bounded/redacted).
VLM_EXPERIMENT_LOG_RAW_MODEL_TEXT=false

# Provider keys and models — set locally only; never commit real credentials.
GEMINI_API_KEY=<set-locally>
GEMINI_MODEL=
GROQ_API_KEY=<set-locally>
GROQ_MODEL=
OPENROUTER_API_KEY=<set-locally>
OPENROUTER_MODEL=

# Self-hosted local VLM (Gemma) — OpenAI-compatible endpoint, UAT (M5.6 §15-20).
# Base URL is the OpenAI-compatible base; the provider calls POST <base>/chat/completions.
LOCAL_VLM_BASE_URL=
LOCAL_VLM_MODEL=
LOCAL_VLM_API_KEY=<set-locally>
LOCAL_VLM_TIMEOUT_SECONDS=60
LOCAL_VLM_MAX_IMAGES=3
LOCAL_VLM_VERIFY_TLS=true

# Transaction file storage (M5.7 §7, §79-81). Filesystem-only; no object storage.
FILE_STORAGE_ROOT=./local-data/file-storage

# Portrait processing (M5.7 §37-40, §110).
PORTRAIT_PROCESSING_ENABLED=true
PORTRAIT_BACKGROUND_MODE=solid
PORTRAIT_BACKGROUND_COLOR=#FFFFFF
PORTRAIT_CROP_MODE=passport
PORTRAIT_OUTPUT_FORMAT=jpeg
PORTRAIT_JPEG_QUALITY=95
# Path to the provisioned MODNet ONNX model (see backend/scripts/provision-portrait-model.sh).
# Leave empty to run the pipeline tests only; processing then reports a technical error.
PORTRAIT_MODEL_PATH=./model-assets/modnet_photographic_portrait_matting.onnx
# Pinned SHA-256 of the model asset (verified at load; M5.7 §52).
PORTRAIT_MODEL_SHA256=07c308cf0fc7e6e8b2065a12ed7fc07e1de8febb7dc7839d7b7f15dd66584df9
# Test-only fake segmentation ("fake") for CI/E2E; never set in production.
PORTRAIT_SEGMENTATION_PROVIDER=

# ---------------------------------------------------------------------------
# M5.8 Secure Consumer Integration (same-origin topology).
# ---------------------------------------------------------------------------

# Browser-facing public origin used to build launch URLs (never the backend's own origin).
# Local dev: the Vite server is the public origin.
PUBLIC_LIVEPHOTO_BASE_URL=http://localhost:5173
# Path to consumer profiles (committed example; real profiles mounted, local copy gitignored).
# Relative to the backend cwd (backend/), so local runs use ./config/consumers.local.json.
CONSUMER_PROFILES_PATH=./config/consumers.example.json

# Launch capability token (opaque, >=256-bit, hash-only persistence).
LAUNCH_TOKEN_TTL_SECONDS=600
# Browser session + CSRF cookies.
BROWSER_SESSION_TTL_SECONDS=1800
BROWSER_COOKIE_SECURE=false          # true outside local
BROWSER_COOKIE_SAMESITE=strict

# S2S authentication. "" = unconfigured (S2S refused) | jwt | local_dev (local/test/dev only).
S2S_AUTH_MODE=local_dev
S2S_LOCAL_DEV_TOKEN=<set-locally>
S2S_JWT_ISSUER=
S2S_JWT_AUDIENCE=livephoto
S2S_JWT_JWKS_URL=                    # http(s) always; local file path only non-uat/prod
S2S_JWT_CLIENT_ID_CLAIM=client_id
S2S_JWT_CLOCK_SKEW_SECONDS=30

# Outbound consumer callback.
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=2

# Server-authoritative capture-attempt policy (warning at 5, again at 7, terminal at 10).
CAPTURE_ATTEMPT_WARNING_AT=5
CAPTURE_ATTEMPT_WARNING_AGAIN_AT=7
CAPTURE_ATTEMPT_LIMIT=10

# Test-only canonical PASS writer (local/test/development only; NEVER in uat/production).
DECISION_TEST_WRITER_ENABLED=false