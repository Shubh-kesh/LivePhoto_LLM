# ---------------------------------------------------------------------------
# LivePhoto environment configuration (safe placeholders only).
# Copy to backend/.env for local development:  cp .env.example backend/.env
# Never commit real credentials, keys, bank URLs or customer identifiers.
# ---------------------------------------------------------------------------

# Application metadata
APP_NAME=LivePhoto
APP_ENV=local                 # local | test | development | uat | production
APP_VERSION=0.1.0

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console            # console (human) | json (production)

# CORS (JSON array of origins)
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false

# Persistence (MSSQL in production; optional locally)
# Leave empty to run the foundation without a database.
# Example SQL Server URL is intentionally left blank; do not commit real DSNs.
DATABASE_URL=

# OpenTelemetry (extension point; no collector configured in M1)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=livephoto-backend
OTEL_TRACES_EXPORTER=none     # none | console

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Security headers
HSTS_ENABLED=false            # enable only when serving over HTTPS in production

# VLM experiment (M4/M5.6) — DISABLED by default. See docs/UAT_RUNTIME_CONFIGURATION.md.
VLM_EXPERIMENT_ENABLED=false
# UAT: experiment available only when BOTH VLM_EXPERIMENT_ENABLED=true AND this is true.
VLM_UAT_LOCAL_EXPERIMENT_ENABLED=false
VLM_PROVIDER=                 # gemini | groq | openrouter | local | mock (empty = none)
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=1
VLM_MAX_FRAMES=3
VLM_MAX_SINGLE_IMAGE_BYTES=5242880
VLM_MAX_TOTAL_IMAGE_BYTES=15728640

# Structured VLM request/response/error diagnostics logging (M5.6 §27-36).
VLM_EXPERIMENT_LOGGING_ENABLED=false
# Optional raw LOCAL model response text (local provider only, non-production, bounded/redacted).
VLM_EXPERIMENT_LOG_RAW_MODEL_TEXT=false

# Provider keys and models — set locally only; never commit real credentials.
GEMINI_API_KEY=<set-locally>
GEMINI_MODEL=
GROQ_API_KEY=<set-locally>
GROQ_MODEL=
OPENROUTER_API_KEY=<set-locally>
OPENROUTER_MODEL=

# Self-hosted local VLM (Gemma) — OpenAI-compatible endpoint, UAT (M5.6 §15-20).
# Base URL is the OpenAI-compatible base; the provider calls POST <base>/chat/completions.
LOCAL_VLM_BASE_URL=
LOCAL_VLM_MODEL=
LOCAL_VLM_API_KEY=<set-locally>
LOCAL_VLM_TIMEOUT_SECONDS=60
LOCAL_VLM_MAX_IMAGES=3
LOCAL_VLM_VERIFY_TLS=true